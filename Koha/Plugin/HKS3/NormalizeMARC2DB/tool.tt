[% INCLUDE 'doc-head-open.inc' %]
    <title>NormalizeMarc2DB jobs</title>
[% INCLUDE 'doc-head-close.inc' %]

<style>
ul {
    list-style: none;
    padding: 0;
    margin: 0;
}

li {
    margin: 10px 0;
}
</style>

</head>
<body>

[% INCLUDE 'header.inc' %]
[% INCLUDE 'cat-search.inc' %]

<div id="doc3">

    <h3> NormalizeMarc2DB jobs </h3>

    <form method="get">
        <input type="hidden" name="class" value="[% CLASS | html %]"/>
        <input type="hidden" name="method" value="[% METHOD | html %]"/>

        <ul>
            <li>
                <fieldset>
                    <h2>Batched reindex</h2>
                        <ul>
                            <li>Without force, only records without an nm2db entry are normalized.</li>
                            <li>Forced batches continue after the last processed ID</li>
                            <li>Current forced reindex phase: [% force_normalize_phase | html%].</li>
                            <li>
			    [%- IF (force_normalize_phase == 'biblio' ) -%]
				Current forced biblionumber: [% force_normalize_biblionumber | html %]
			    [%- ELSE -%]
				Current forced authority id: [% force_normalize_authid | html %]
			    [%- END -%]
                            </li>
                            [% IF lowest_unindexed_biblionumber %]<li>Lowest unindexed biblionumber: [% lowest_unindexed_biblionumber | html %]</li>[% END %]
                            [% IF lowest_unindexed_authid %]<li>Lowest unindexed authid: [% lowest_unindexed_authid | html %]</li>[% END %]
                        </ul>
                    <label for="limit">Records per run</label>
                    <input id="limit" type="number" name="limit" min="1" step="1" value="1000" required>
                    <label><input type="checkbox" name="skip_authorities" value="1"> Skip authorities</label>
                    <label><input type="checkbox" name="force" value="1"> Force reindex already normalized records</label>
                    <button type="submit" name="run" value="NormalizeAll"> Normalize next batch </button>
                </fieldset>
            </li>
        
            <li>
                <button type="submit" name="run" value="ResetForceNormalize"> Restart forced reindex from the beginning </button>
            </li>
            <li> <button type="submit" name="run" value="VerifyAll"> Verify normalized data against stored marcxml </button>
            <li> <button type="submit" name="run" value="ViewChangedMetadata">
                Check what UpdateChangedMetadata would change
            </button>
            <li> <button type="submit" name="run" value="UpdateChangedMetadata">
                Updated stored marcxml with new normalized data
            </button>
        </ul>
    </form>
</div>
